#!/bin/bash

# Open location after navigation in ranger
alias ranger=". ranger"

# Use neovim if available
if command -v nvim > /dev/null; then
  alias vim="nvim"
fi

# Manage dotfiles repository
alias config='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

# Exa
alias ll="eza -l -g --icons --git"
alias llt="eza -1 --icons --tree --git-ignore"

# GitHub Copilot CLI
eval "$(gh copilot alias -- zsh)"
alias \?\?="ghcs -t shell"
alias git\?="ghcs -t git"
alias gh\?="ghcs -t gh"

# Zathura
alias pdf="zathura"

# Claude Code
alias claudex="CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 \
  CLAUDE_CODE_SUBAGENT_MODEL=gpt-5.6-so1 \
  CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1 \
  CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=3 \
  ENABLE_TOOL_SEARCH=false \
  claude --model gpt-5.6-so1"
